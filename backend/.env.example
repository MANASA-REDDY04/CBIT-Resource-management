# Database Connection URL (PostgreSQL)
# Format: postgresql://username:password@hostname:5432/database_name
# For Render PostgreSQL: copy Internal or External Database URL from Render Dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cbit_resource_hub

# JWT and Session Security
SECRET_KEY=cbit_resource_hub_dev_secret_key_change_in_production_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Environment ('development' or 'production')
APP_ENV=development

# Allowed Frontend URL for CORS and cookie origin
FRONTEND_URL=http://localhost:3000

# Cookie security settings (Set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

